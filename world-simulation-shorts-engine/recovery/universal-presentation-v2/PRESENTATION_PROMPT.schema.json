{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:world-engine:presentation-prompt:v2",
  "title": "WORLD ENGINE bounded natural-language plus authoritative data V2",
  "description": "Structural validation only. Actual source bytes/coverage, data evidence, native Scene compiler, presentation references, full camera coverage and Studio safety gates also run. This does not certify facts or video quality.",
  "x-reusedFactsSchema": {
    "file": "../universal-data-pipeline-v1/PROMPT_INPUT.schema.json",
    "sha256": "c29eba0a4bed7a84f5feb95f5feba6ec2ff737e318887cdbfda6ad07297e04b4",
    "semantics": "Unchanged facts definitions; only optional display scalar resolution belongs to new version."
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "WORLD_ENGINE_PRESENTATION_PROMPT_V2"
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "data": {
      "$ref": "#/$defs/attachedData"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "countryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "crs": {
          "const": "EPSG:4326"
        },
        "legacyProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "countryName": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "center",
        "bbox"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "camera": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "KEYFRAMES"
                },
                "keyframes": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "frame": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "center": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "minimum": -180,
                            "maximum": 180
                          },
                          {
                            "type": "number",
                            "minimum": -90,
                            "maximum": 90
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                      },
                      "zoom": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "frame",
                      "center",
                      "zoom"
                    ]
                  }
                }
              },
              "required": [
                "mode",
                "keyframes"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "ROUTE_FOLLOW"
                },
                "routeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "zoom": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "followStrength": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "mode",
                "routeId"
              ]
            }
          ]
        },
        "territoryColors": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "number",
                "minimum": 0.08,
                "maximum": 0.6
              }
            ]
          }
        },
        "highlights": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "locationId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "endFrame": {
                "type": "integer",
                "minimum": 2
              }
            },
            "required": [
              "id",
              "locationId",
              "startFrame",
              "endFrame"
            ]
          }
        },
        "sceneOverrides": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "camera": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "const": "KEYFRAMES"
                      },
                      "keyframes": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 32,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "frame": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "center": {
                              "type": "array",
                              "prefixItems": [
                                {
                                  "type": "number",
                                  "minimum": -180,
                                  "maximum": 180
                                },
                                {
                                  "type": "number",
                                  "minimum": -90,
                                  "maximum": 90
                                }
                              ],
                              "minItems": 2,
                              "maxItems": 2
                            },
                            "zoom": {
                              "type": "number",
                              "exclusiveMinimum": 0,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "frame",
                            "center",
                            "zoom"
                          ]
                        }
                      }
                    },
                    "required": [
                      "mode",
                      "keyframes"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "mode": {
                        "const": "ROUTE_FOLLOW"
                      },
                      "routeId": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      },
                      "zoom": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                      },
                      "followStrength": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "mode",
                      "routeId"
                    ]
                  }
                ]
              },
              "territoryColors": {
                "type": "object",
                "maxProperties": 8,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number",
                      "minimum": 0.08,
                      "maximum": 0.6
                    }
                  ]
                }
              },
              "highlights": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "locationId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "startFrame": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "endFrame": {
                      "type": "integer",
                      "minimum": 2
                    }
                  },
                  "required": [
                    "id",
                    "locationId",
                    "startFrame",
                    "endFrame"
                  ]
                }
              },
              "initialStateVisibility": {
                "enum": [
                  "REVEAL",
                  "PRESERVE_PROVIDED"
                ]
              }
            },
            "required": []
          }
        },
        "transitions": {
          "type": "array",
          "maxItems": 63,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "CUT"
              },
              "frame": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "type",
              "frame"
            ]
          }
        },
        "initialStateVisibility": {
          "enum": [
            "REVEAL",
            "PRESERVE_PROVIDED"
          ]
        }
      },
      "required": []
    }
  },
  "required": [
    "schema",
    "prompt",
    "data",
    "region"
  ],
  "$defs": {
    "attachedData": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:world-engine:attached-data:presentation:v2",
      "title": "Attached native data with optional scalar extraction for presentation V2",
      "description": "Existing facts shape reused without field changes. Display topic, duration, fps and resolution may be resolved by the new bounded parser; actual unchanged validators still run.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "WORLD_ENGINE_DATA_PROMPT_V1"
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "simulationType": {
          "enum": [
            "HISTORICAL",
            "FICTIONAL",
            "GENERAL"
          ]
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sceneId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              },
              "endFrame": {
                "type": "integer",
                "minimum": 1
              },
              "facts": {
                "$ref": "#/$defs/facts"
              },
              "renderSettings": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sourceRegionId": {
                    "type": "string",
                    "enum": [
                      "namibia_desert_coast",
                      "europe_germany",
                      "south_america_chile",
                      "korean_peninsula",
                      "nepal_himalaya"
                    ]
                  }
                },
                "required": []
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                }
              },
              "historicalEvidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "recordId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "sourceId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "claimId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    },
                    "geometryIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      }
                    },
                    "stageIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      }
                    }
                  },
                  "required": [
                    "recordId",
                    "sourceId",
                    "claimId"
                  ]
                }
              }
            },
            "required": [
              "sceneId",
              "startFrame",
              "endFrame",
              "facts"
            ]
          }
        },
        "renderSettings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceRegionId": {
              "type": "string",
              "enum": [
                "namibia_desert_coast",
                "europe_germany",
                "south_america_chile",
                "korean_peninsula",
                "nepal_himalaya"
              ]
            }
          },
          "required": []
        }
      },
      "required": [
        "schema",
        "simulationType",
        "scenes"
      ],
      "$defs": {
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": "PLANNER_FACTS_V1"
            },
            "data_mode": {
              "enum": [
                "SYNTHETIC_TEST",
                "PRODUCTION"
              ]
            },
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "aliases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "event_family": {
                  "enum": [
                    "WAR",
                    "TRANSPORT",
                    "LINE_METRIC",
                    "DISASTER"
                  ]
                }
              },
              "required": [
                "id",
                "label",
                "aliases",
                "event_family"
              ]
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "anchor": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "country_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "anchor"
                ]
              }
            },
            "time_range": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date"
                },
                "end": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            "source_notes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "source_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification_basis": {
                    "type": "string",
                    "minLength": 1
                  },
                  "live_access": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retrieval_date": {
                    "type": "string",
                    "minLength": 1
                  },
                  "license": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "original_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "source_wrapper_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "crs": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resolution": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "source_type",
                  "source_reference",
                  "verification_status"
                ]
              }
            },
            "geometries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "source_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "geometry": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "enum": [
                          "Point",
                          "LineString",
                          "Polygon",
                          "MultiPolygon"
                        ]
                      },
                      "coordinates": {
                        "type": "array"
                      }
                    },
                    "required": [
                      "type",
                      "coordinates"
                    ]
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "source_id",
                  "geometry"
                ]
              }
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "area_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  },
                  "front_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_.:-]+$"
                    }
                  }
                },
                "required": [
                  "id",
                  "date",
                  "label",
                  "area_refs",
                  "front_refs"
                ]
              }
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "geometry_ref": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  },
                  "direction": {
                    "enum": [
                      "FORWARD",
                      "REVERSE"
                    ]
                  },
                  "object_role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "object_profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required_for_story": {
                    "type": "boolean"
                  },
                  "object_graphic": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "width_px": {
                        "type": "number",
                        "minimum": 24,
                        "maximum": 80
                      },
                      "height_px": {
                        "type": "number",
                        "minimum": 12,
                        "maximum": 80
                      },
                      "polygons": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 8,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "points": {
                              "type": "array",
                              "minItems": 3,
                              "maxItems": 12,
                              "items": {
                                "type": "array",
                                "minItems": 2,
                                "maxItems": 2,
                                "items": {
                                  "type": "number",
                                  "minimum": -0.5,
                                  "maximum": 0.5
                                }
                              }
                            },
                            "color": {
                              "type": "array",
                              "minItems": 4,
                              "maxItems": 4,
                              "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            }
                          },
                          "required": [
                            "points",
                            "color"
                          ]
                        }
                      }
                    },
                    "required": [
                      "width_px",
                      "height_px",
                      "polygons"
                    ]
                  }
                },
                "required": [
                  "id",
                  "geometry_ref",
                  "object_role"
                ]
              }
            },
            "camera": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "anchor": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "target_geometry_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  }
                },
                "minimum_context_geometry_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+$"
                  }
                },
                "detail_policy": {
                  "const": "FACT_BASED_VISUAL_GRADE"
                },
                "native_context": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "country_ids": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_.:-]+$"
                      }
                    },
