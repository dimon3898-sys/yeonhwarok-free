      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "start_time",
          "duration",
          "scene_type",
          "narration",
          "location",
          "coordinates",
          "geographic_targets",
          "camera_preset",
          "camera_start",
          "camera_end",
          "camera_speed",
          "camera_easing",
          "lighting_preset",
          "entities",
          "entity_actions",
          "routes",
          "visual_events",
          "effects",
          "labels",
          "sound_events",
          "music_energy",
