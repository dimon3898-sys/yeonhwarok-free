          },
          "location": {
            "type": "string"
          },
          "camera_preset": {
            "type": "string"
          },
          "camera_easing": {
            "type": "string"
          },
          "lighting_preset": {
            "type": "string"
          },
          "transition_in": {
            "type": "string"
