{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-simulation.local/schema/scene-plan/1.0",
  "title": "World Simulation Scene Plan 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "duration",
    "request",
    "options",
    "story",
    "scenes",
    "required_plugins",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^v[0-9]{3,}$"
        }
      ]
    },
    "duration": {
      "type": "number",
      "minimum": 5
    },
    "request": {
      "type": "object",
      "required": [
        "topic",
        "duration"
      ]
    },
    "options": {
      "type": "object",
      "required": [
        "tts",
        "subtitles",
        "bgm",
        "quality"
      ],
      "properties": {
        "tts": {
          "type": "boolean"
        },
        "subtitles": {
          "type": "boolean"
        },
        "bgm": {
          "type": "boolean"
        },
        "quality": {
          "enum": [
            "FAST",
            "HIGH",
            "CINEMA"
          ]
        },
        "narration_file": {
          "type": "string"
        },
        "narration_timing": {
          "type": "array"
        },
        "tts_language": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "story": {
      "type": "object",
      "required": [
        "hook",
        "claims",
        "beats"
      ],
      "properties": {
        "hook": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text",
              "status",
              "source_ids"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "FACT",
                  "ASSUMPTION",
                  "SIMULATION"
                ]
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "assumption_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scope": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conclusion": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "planner": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
